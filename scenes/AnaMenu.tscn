[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ana_menu.gd" id="1"]

[node name="AnaMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="ArkaPlan" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.05, 0.09, 1)

[node name="Panel" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -210.0
offset_top = -250.0
offset_right = 210.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 22

[node name="Baslik" type="Label" parent="Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.22, 0.3, 1)
theme_override_font_sizes/font_size = 64
text = "TETRİS"
horizontal_alignment = 1

[node name="Aciklama" type="Label" parent="Panel"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Godot 4 • Masaüstü • Web • Android"
horizontal_alignment = 1

[node name="Basla" type="Button" parent="Panel"]
layout_mode = 2
